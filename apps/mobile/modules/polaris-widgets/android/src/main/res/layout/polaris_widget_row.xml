<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/polaris_row" android:layout_width="match_parent" android:layout_height="32dp"
  android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/polaris_row_glyph" android:layout_width="14dp"
    android:layout_height="20dp" android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
  <TextView android:id="@+id/polaris_row_title" android:layout_width="0dp"
    android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1"
    android:ellipsize="end" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
  <TextView android:id="@+id/polaris_row_trailing" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:maxLines="1" android:textSize="13sp"
    android:layout_marginStart="8dp" android:fontFamily="sans-serif" />
</LinearLayout>
