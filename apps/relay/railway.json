{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/relay-rs/Dockerfile",
    "watchPatterns": ["apps/relay-rs/**", "apps/relay/railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "drainingSeconds": 10
  }
}
