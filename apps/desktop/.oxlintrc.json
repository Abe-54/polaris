{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/lint-config/oxlint.json"],
  "overrides": [
    {
      "files": ["src/main/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Main's internet requests use internetFetch (src/main/net.ts): Node's fetch ignores the system proxy and certificates."
          }
        ]
      }
    },
    {
      "files": ["src/renderer/**"],
      "plugins": ["typescript", "oxc", "react", "jsx-a11y"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/jsx-key": "error",
        "react/no-danger": "error",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-autofocus": "off"
      }
    }
  ]
}
