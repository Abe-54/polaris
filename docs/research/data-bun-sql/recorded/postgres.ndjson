{"label":"introspection-tree","engine":"postgres","statements":["SELECT n.nspname AS schema, c.relname AS name, c.relkind AS kind,\n    c.reltuples AS row_estimate, count(a.attnum)::int AS column_count\n    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace\n    LEFT JOIN pg_attribute a ON a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped\n    WHERE n.nspname=current_schema() AND c.relkind IN ('r','p','v','m','f')\n    GROUP BY n.nspname,c.oid ORDER BY c.relname"],"timesMs":[1.9468750000005457,1.1853329999994457,1.2570830000004207,1.2384159999992335,1.1955410000000484],"count":304,"sample":[{"schema":"public","name":"million","kind":"r","row_estimate":-1,"column_count":2},{"schema":"public","name":"probe","kind":"r","row_estimate":-1,"column_count":2},{"schema":"public","name":"probe_view","kind":"v","row_estimate":-1,"column_count":2},{"schema":"public","name":"t_0","kind":"r","row_estimate":1,"column_count":4},{"schema":"public","name":"t_1","kind":"r","row_estimate":-1,"column_count":4}]}
{"label":"introspection-columns","engine":"postgres","statements":["SELECT a.attname AS name, format_type(a.atttypid,a.atttypmod) AS type,\n    NOT a.attnotnull AS nullable, pg_get_expr(d.adbin,d.adrelid) AS default_value,\n    EXISTS(SELECT 1 FROM pg_constraint p WHERE p.conrelid=a.attrelid AND p.contype='p' AND a.attnum=ANY(p.conkey)) AS primary_key\n    FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum\n    WHERE a.attrelid='t_0'::regclass AND a.attnum>0 AND NOT a.attisdropped ORDER BY a.attnum"],"timesMs":[0.7432079999998678,0.3255830000007336,0.28120899999976245,0.24087500000041473,0.3639579999999114],"count":4,"sample":[{"name":"id","type":"integer","nullable":false,"default_value":null,"primary_key":true},{"name":"parent_id","type":"integer","nullable":true,"default_value":null,"primary_key":false},{"name":"label","type":"character varying(80)","nullable":true,"default_value":"'x'::character varying","primary_key":false},{"name":"amount","type":"numeric(30,10)","nullable":true,"default_value":null,"primary_key":false}]}
{"label":"introspection-constraints","engine":"postgres","statements":["SELECT c.conname AS name,c.contype AS kind,pg_get_constraintdef(c.oid) AS definition,\n    rn.nspname AS target_schema,rc.relname AS target_table,\n    ARRAY(SELECT a.attname FROM unnest(c.conkey) WITH ORDINALITY k(attnum,n)\n      JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum=k.attnum ORDER BY k.n) AS source_columns,\n    ARRAY(SELECT a.attname FROM unnest(c.confkey) WITH ORDINALITY k(attnum,n)\n      JOIN pg_attribute a ON a.attrelid=c.confrelid AND a.attnum=k.attnum ORDER BY k.n) AS target_columns\n    FROM pg_constraint c LEFT JOIN pg_class rc ON rc.oid=c.confrelid\n    LEFT JOIN pg_namespace rn ON rn.oid=rc.relnamespace WHERE c.conrelid='t_0'::regclass ORDER BY c.conname"],"timesMs":[0.7445830000006026,0.4248330000000351,0.31524999999965075,0.4192089999996824,0.4107500000000073],"count":3,"sample":[{"name":"t_0_amount_check","kind":"c","definition":"CHECK ((amount >= (0)::numeric))","target_schema":null,"target_table":null,"source_columns":["amount"],"target_columns":[]},{"name":"t_0_parent_id_fkey","kind":"f","definition":"FOREIGN KEY (parent_id) REFERENCES probe(id)","target_schema":"public","target_table":"probe","source_columns":["parent_id"],"target_columns":["id"]},{"name":"t_0_pkey","kind":"p","definition":"PRIMARY KEY (id)","target_schema":null,"target_table":null,"source_columns":["id"],"target_columns":[]}]}
