{
  "name": "polaris",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling",
    "extensions/raycast",
    "extensions/even-g2"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "daemon:dev": "sh scripts/daemon-dev.sh --watch serve --foreground",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "turbo run bench --log-prefix=none --",
    "lint": "oxfmt --check && bun tooling/lint/ratchet.ts && bun tooling/test/quarantine.ts --check",
    "lint:baseline": "bun tooling/lint/ratchet.ts --update-baseline",
    "format": "oxfmt",
    "spec": "bun --cwd packages/spec scripts/check.ts",
    "format:check": "oxfmt --check",
    "quality": "bun tooling/quality/run.ts",
    "prepare": "bun tooling/hooks/install.ts",
    "licenses": "bun scripts/licenses.ts",
    "licenses:check": "bun scripts/licenses.ts --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "effect": "4.0.0-rc.118",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ],
  "overrides": {
    "@types/node": "26.6.3"
  },
  "patchedDependencies": {
    "sodium-native@5.2.0": "patches/sodium-native@5.2.0.patch",
    "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch",
    "@react-native/gradle-plugin@0.88.0": "patches/@react-native%2Fgradle-plugin@0.88.0.patch"
  }
}
