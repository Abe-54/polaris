{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "patches/**"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@polaris/daemon#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-daemon.ts"],
      "outputs": ["dist/**"]
    },
    "@polaris/site#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "AXIOM_DOMAIN",
        "AWS_REGION",
        "AWS_ROLE_ARN",
        "POLARIS_EMAIL_FROM",
        "POLARIS_EMAIL_CONFIGURATION_SET",
        "POLARIS_EMAIL_LIMIT_SECRET",
        "POLARIS_EMAIL_TRANSPORT",
        "POLARIS_PUSH_SECRET",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["POLARIS_PBT_*", "POLARIS_EXPECT_ELEVATED"],
      "passThroughEnv": ["POLARIS_TEST_PARALLEL", "CI", "GITHUB_STEP_SUMMARY"]
    },
    "dev": { "cache": false, "persistent": true },
    "bench": {
      "cache": false,
      "passThroughEnv": ["POLARIS_*", "BUN_*", "GITHUB_STEP_SUMMARY", "TMPDIR"]
    }
  }
}
